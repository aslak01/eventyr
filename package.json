{
  "name": "eventyr",
  "version": "1.0.0",
  "description": "Static site generator for books with TypeScript and Sharp image optimization",
  "main": "static-generator.ts",
  "scripts": {
    "build": "bun run static-generator.ts",
    "dev": "bun run dev-server.ts",
    "format": "prettier -w .",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "bun",
    "static-site-generator",
    "markdown",
    "books",
    "typescript",
    "sharp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lightningcss": "^1.33.0",
    "marked": "^18.1.3",
    "marked-footnote": "^1.4.0",
    "marked-hook-frontmatter": "^1.4.5",
    "marked-sequential-hooks": "^1.2.2",
    "sharp": "^0.34.5",
    "sortable-tablesort": "^4.1.7"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.3",
    "@types/bun": "^1.4.4",
    "browserslist": "^4.29.5",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
